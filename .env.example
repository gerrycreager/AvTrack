# Copy to .env and fill in. Never commit the real .env.

# Native local dev (default): points at the PostgreSQL+PostGIS already installed on
# this machine. Docker Compose overrides this itself (db service hostname) -- don't
# need to change it for that path.
DATABASE_URL=postgresql+asyncpg://avtrack:avtrack_dev_only@localhost:5432/avtrack

# FlightAware AeroAPI (https://www.flightaware.com/aeroapi/)
FLIGHTAWARE_API_KEY=

# Comma-separated callsign prefixes tracked by default (see REQUIREMENTS.md 3.1)
DEFAULT_CALLSIGN_PREFIXES=CAP,PARD

# Seconds between ADS-B polls per tracked aircraft set
ADSB_POLL_INTERVAL_SECONDS=15
