# AvTrack backend (FastAPI/uvicorn) on r815. Added 2026-09-13 after a real outage
# (then running on cosp1): the backend had only ever been started manually via
# `nohup ... &`, which does not survive a reboot. Gerry rebooted cosp1 for a
# software update, the backend never came back, and r815's Apache reverse proxy
# (deploy/r815-avtrack.conf) started returning 503 Service Unavailable to anyone
# hitting the public URL -- a real user-facing outage caused purely by not having
# this as a real service. Restart=always + WantedBy=multi-user.target fixes both
# the "survives reboot" and "survives a crash" cases.
#
# Moved from cosp1 to r815 2026-11-01 (REQUIREMENTS.md) -- r815 got a RAM upgrade
# and had the headroom. The database did NOT move here too: it's on data2
# (matches WxCOP's existing backend-on-r815/DB-on-data2 split, see
# DATABASE_URL in .env) -- so this unit deliberately has no local Postgres
# dependency, just network reachability to reach data2 over the LAN.
#
# Install (one-time, on r815):
#   sudo cp avtrack-backend.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now avtrack-backend

[Unit]
Description=AvTrack backend (FastAPI/uvicorn)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=gerry
WorkingDirectory=/home/gerry/CAP/AvTrack/backend
ExecStart=/home/gerry/CAP/AvTrack/backend/.venv/bin/uvicorn app.main:app --host 192.168.0.200 --port 8000 --app-dir .
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
